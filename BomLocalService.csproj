<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.1</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Local overrides remain usable during development but never ship. -->
    <Content Update="**/appsettings.Local.json;**/appsettings.local.json;**/appsettings.Overrides.json;**/appsettings.*.local.json"
             CopyToPublishDirectory="Never" />
    <None Update="**/appsettings.Local.json;**/appsettings.local.json;**/appsettings.Overrides.json;**/appsettings.*.local.json"
          CopyToPublishDirectory="Never" />
    <Content Update="global.json" CopyToPublishDirectory="Never" />
    <None Update="global.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Keep the application project at the repository root from compiling or publishing tests,
       fixtures, verification artifacts, or the runtime cache. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs;artifacts/**;cache/**" />
    <Content Remove="tests/**;artifacts/**;cache/**" />
    <EmbeddedResource Remove="tests/**;artifacts/**;cache/**" />
    <None Remove="tests/**;artifacts/**;cache/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.57.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
  </ItemGroup>

</Project>
