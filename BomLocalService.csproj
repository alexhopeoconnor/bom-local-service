<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.0.6</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Local overrides remain usable during development but never ship. -->
    <Content Update="**/appsettings.Local.json;**/appsettings.local.json;**/appsettings.Overrides.json;**/appsettings.*.local.json"
             CopyToPublishDirectory="Never" />
    <None Update="**/appsettings.Local.json;**/appsettings.local.json;**/appsettings.Overrides.json;**/appsettings.*.local.json"
          CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.57.0" />
  </ItemGroup>

</Project>
